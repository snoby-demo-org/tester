# civicnet node config
# Set rpcpassword at deploy time; keep the password secret.
rpcuser=coin
rpcpassword=CHANGE_ME
rpcport=9332
rpcallowip=127.0.0.1
rpcbind=0.0.0.0

# P2P
port=9333
listen=1
server=1

# ZMQ (pool feed) — also set by the container entrypoint
# zmqpubhashblock=tcp://0.0.0.0:28332
# zmqpubhashtx=tcp://0.0.0.0:28333
# zmqpubrawblock=tcp://0.0.0.0:28334
# zmqpubrawtx=tcp://0.0.0.0:28335
